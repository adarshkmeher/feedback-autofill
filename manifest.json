{
  "manifest_version": 3,
  "name": "IIT KGP ERP Feedback Autofill",
  "version": "2.1.0",
  "description": "Fills the IIT KGP ERP subject feedback form with answers you save once. You type the security code and press Submit.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/Academic/studentFeedbackResponseView.htm*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Feedback autofill settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
